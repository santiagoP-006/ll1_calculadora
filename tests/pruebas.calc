// ── Prueba 1: Operaciones básicas ──
3 + 5
10 - 4
6 * 7
20 / 4
17 % 5

// ── Prueba 2: Precedencia de operadores ──
2 + 3 * 4
(2 + 3) * 4
10 - 2 * 3 + 1

// ── Prueba 3: Asignación de variables ──
x = 10
y = 3
x + y
x * y - 2

// ── Prueba 4: Funciones trigonométricas (ángulos en grados) ──
sin(30)
cos(60)
tan(45)

// ── Prueba 5: Valor absoluto ──
abs(-15)
abs(7)
abs(-3 * 4)

// ── Prueba 6: Negación unaria ──
-8 + 3
-x + y

// ── Prueba 7: Expresiones anidadas ──
sin(30) + cos(60)
abs(-10) * 2 + sin(90)

// ── Prueba 8: Módulo ──
10 % 3
x % y
